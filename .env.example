# Copia este archivo a `.env` y rellena los valores.
# El Client ID de Azure es PÚBLICO (no es un secreto): va embebido en el launcher.

# Id. de aplicación (cliente) de la app de Azure/Entra para el login premium.
AZURE_CLIENT_ID=

# URL pública del Worker PaputAuth. Es pública; déjala vacía hasta desplegarlo.
PAPUT_API_URL=

# Grupo oficial que se instala automáticamente; el jugador no escribe códigos.
PAPUT_GROUP_BASE_URL=
PAPUT_GROUP_ID=
